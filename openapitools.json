{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.25.0",
    "generators": {
      "rest-client": {
        "generatorName": "typescript-fetch",
        "inputSpec": "../contract/openapi.yaml",
        "output": "src/api/generated",
        "additionalProperties": {
          "supportsES6": true,
          "withInterfaces": true,
          "npmName": "@ananoesis/generated-api"
        }
      }
    }
  }
}
